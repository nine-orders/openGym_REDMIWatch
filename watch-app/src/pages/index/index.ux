<template>
  <div class="pg">
    <div class="head">
      <div class="brand">
        <image class="app-icon" src="/brand-icon.png"></image>
        <div class="wordmark">
          <text class="brand-en">openGym</text>
          <text class="brand-zh">开炼</text>
        </div>
      </div>
      <text class="settings" onclick="goSettings">设置</text>
    </div>

    <div class="device" onclick="goPair">
      <div class="device-info">
        <div class="{{ connectionClass }}"></div>
        <text class="device-label">{{ deviceLabel }}</text>
      </div>
      <text class="switch">切换 ›</text>
    </div>

    <div class="independent" onclick="startTap">
      <div class="card-copy">
        <text class="primary-title">独立训练</text>
        <text class="primary-sub">{{ independentActive ? '继续本次训练' : '选择动作单' }}</text>
      </div>
      <text class="primary-arrow">›</text>
    </div>

    <div class="phone" onclick="phoneTap">
      <div class="card-copy">
        <text class="phone-title">同步手机</text>
        <text class="phone-sub">{{ phoneLabel }}</text>
      </div>
      <text class="phone-arrow">›</text>
    </div>

    <div class="pending" onclick="goPending">
      <div class="{{ pendingClass }}"></div>
      <text class="pending-label">{{ pendingLabel }}</text>
      <text class="pending-arrow">›</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { readDevice } from '../../js/connections'
import { getJSON } from '../../js/store'
import { canSendPending, connectionFailure, pendingText, readPending, refreshConnection, sendPending } from '../../js/home-sync'

export default {
  data: {
    independentActive: false,
    deviceLabel: '正在读取连接…',
    connectionClass: 'dot dot-idle',
    phoneLabel: '需要连接手机',
    pendingLabel: '正在读取同步记录…',
    pendingClass: 'dot dot-idle'
  },
  async onShow() {
    this.stopRefresh()
    const view = this._view = {}
    const [device, active] = await Promise.all([readDevice(), getJSON('active', null)])
    if (this._view !== view) return
    this.independentActive = !!active
    this.setConnection(device, device.connection ? 'connecting' : 'unpaired')
    const pending = await this.updatePending(view)
    if (this._view !== view || !device.connection) return
    this._refresh = this.refresh(view, device, pending)
    return this._refresh
  },
  onHide() { this.stopRefresh() },
  onDestroy() { this.stopRefresh() },
  stopRefresh() {
    this._view = null
    if (this._poll != null) { clearTimeout(this._poll); this._poll = null }
  },
  setConnection(device, status, live) {
    const phone = device.mode === 'hub'
    const name = phone ? '手机' : '电脑'
    this.deviceLabel = {
      unpaired: device.mode === 'offline' ? '离线模式' : '未配对',
      connecting: '正在连接' + name,
      online: name + '已连接',
      offline: name + '离线 · 已保存连接',
      error: name + '通信异常'
    }[status]
    this.connectionClass = status === 'online' ? 'dot dot-live' : status === 'error' ? 'dot dot-warn' : 'dot dot-idle'
    if (!phone || !device.connection) {
      this.phoneLabel = device.connection ? '切换至手机连接' : '需要连接手机'
    } else if (status === 'online') {
      this.phoneLabel = !live ? '等待手机更新状态' : live.active ? '手机训练中' : '等待手机开始训练'
    } else {
      this.phoneLabel = status === 'connecting' ? '正在检查训练状态' : '同步异常 · 点击重试'
    }
  },
  async updatePending(view, phase, total) {
    const info = await readPending().catch(() => null)
    if (this._view === view) {
      this.pendingLabel = pendingText(info, phase, total)
      this.pendingClass = !info || info.count || info.ungrouped || phase === 'failed' ? 'dot dot-warn' : 'dot dot-live'
    }
    return info
  },
  async refresh(view, device, initial) {
    let delay = 20000
    let live
    try {
      const result = await refreshConnection(device)
      if (this._view !== view) return
      live = result.live
      this.setConnection(device, 'online', live)
      if (device.mode === 'hub') delay = 10000
    } catch (error) {
      if (this._view !== view) return
      this.setConnection(device, connectionFailure(error))
      const info = initial || await this.updatePending(view)
      if (info && canSendPending(info, device, null)) await this.updatePending(view, 'failed')
      if (this._view === view) this._poll = setTimeout(() => this.refresh(view, device), delay)
      return
    }
    const info = initial || await this.updatePending(view)
    const liveWid = live && live.active && live.active.id
    if (this._view === view && info && canSendPending(info, device, liveWid)) {
      await this.updatePending(view, 'sending', info.count)
      let failed = false
      try {
        await sendPending(device, () => this.updatePending(view, 'sending', info.count), liveWid)
      } catch (e) { failed = true }
      const pending = await readPending().catch(() => null)
      failed = failed || !!(pending && canSendPending(pending, device, liveWid))
      await this.updatePending(view, failed ? 'failed' : '')
    }
    if (this._view === view) this._poll = setTimeout(() => this.refresh(view, device), delay)
  },
  async startTap() {
    const active = await getJSON('active', null)
    if (active) router.push({ uri: '/pages/session' })
    else router.push({ uri: '/pages/pick', params: { mode: 'independent' } })
  },
  async phoneTap() {
    const device = await readDevice()
    if (device.mode === 'hub' && device.connection) router.push({ uri: '/pages/session2', params: { follow: '1' } })
    else router.push({ uri: '/pages/pair', params: { focus: 'hub' } })
  },
  goPair() { router.push({ uri: '/pages/pair' }) },
  goSettings() { router.push({ uri: '/pages/settings' }) },
  goPending() { router.push({ uri: '/pages/pending' }) }
}
</script>

<style>
.pg { position: absolute; width: 432px; height: 514px; padding: 20px 24px; background-color: #000000; flex-direction: column; }
.head { height: 77px; align-items: center; justify-content: space-between; margin-bottom: 9px; }
.brand { align-items: center; }
.app-icon { width: 49px; height: 49px; border-radius: 12px; margin-right: 11px; }
.wordmark { flex-direction: column; }
.brand-en { color: #F5F7F2; font-size: 29px; font-weight: bold; }
.brand-zh { color: #A8B098; font-size: 17px; }
.settings { width: 76px; height: 55px; line-height: 55px; background-color: #181D15; border-radius: 17px; color: #F0F4EB; text-align: center; font-size: 20px; }
.device { height: 58px; padding: 0 16px; margin-bottom: 12px; border-radius: 17px; background-color: #141912; align-items: center; justify-content: space-between; }
.device-info { align-items: center; }
.dot { width: 9px; height: 9px; border-radius: 5px; margin-right: 10px; }
.dot-idle { background-color: #87917D; }
.dot-live { background-color: #B7F35C; }
.dot-warn { background-color: #FFBF63; }
.device-label { color: #D9E7C6; font-size: 20px; }
.switch { color: #B7F35C; font-size: 19px; }
.independent { height: 125px; padding: 0 22px; margin-bottom: 12px; border-radius: 25px; background-color: #B7F35C; align-items: center; justify-content: space-between; }
.card-copy { flex-direction: column; }
.primary-title { color: #152508; font-size: 35px; font-weight: bold; }
.primary-sub { color: #344A1F; font-size: 22px; margin-top: 4px; }
.primary-arrow { color: #263D12; font-size: 45px; }
.phone { height: 103px; padding: 0 22px; margin-bottom: 9px; border-radius: 22px; background-color: #213819; align-items: center; justify-content: space-between; }
.phone-title { color: #F2F7EB; font-size: 29px; font-weight: bold; }
.phone-sub { color: #B7F35C; font-size: 20px; margin-top: 4px; }
.phone-arrow { color: #B7F35C; font-size: 38px; }
.pending { height: 61px; padding: 0 13px; align-items: center; }
.pending-label { flex: 1; color: #FFCA81; font-size: 19px; lines: 1; text-overflow: ellipsis; }
.pending-arrow { color: #FFCA81; font-size: 26px; }
</style>
